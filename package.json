{
  "name": "oda-restaurant",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "images:optimize": "node scripts/optimize-carousel-images.mjs",
