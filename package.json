    "postcss": "^8.5.30",
    "postcss-custom-media": "^12.0.3",
    "sharp": "^0.35.4",
    "svelte": "latest",
    "svelte-check": "latest",
    "typescript": "latest",
    "vite": "latest"
  },
  "engines": {
    "node": ">=20.19"
  }
}
